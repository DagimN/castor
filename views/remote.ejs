<!DOCTYPE html>
<html>
  <head>
    <title>Castor Remote</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <style>
      :root{
        --primary: #009689
      }
      body { font-family: Arial, sans-serif; padding: 20px;;background-color: #101828; }
      .images { display: grid; justify-content: center; gap: 10px; margin-bottom: 20px; overflow-y: auto; }
      .images img { height: 500px;  cursor: pointer; border: 2px solid transparent; border-radius: 8px; }
      .images img:hover { border-color: var(--primary); }
      img.selected { border: 10px solid var(--primary);} 
      .state-box { margin-top: 20px; padding: 10px; border: 1px solid #ddd; display: inline-block; border-radius: 6px; }
      .controls {  position: fixed; bottom: 20px; right: 20px }
      button { height: 200px; width: 200px; padding: 8px 12px; margin: 5px; cursor: pointer; border: none; border-radius: 4px; background: var(--primary); color: white; }
      button:hover { background: var(--primary); }
      i { font-size: 40px; }
    </style>
  </head>
  <body onload="initialize('<%= selectedIndex %>', '<%= images.length %>')">
    <div class="images">
      <% images.forEach((img, idx) => { %>
        <img 
          src="<%= img %>" 
          alt="Option <%= idx+1 %>" 
          onclick="updateState('<%= idx %>')" 
          class="image-item" >
      <% }) %>
    </div>

    <!-- Two buttons -->
    <div class="controls">
      <button onclick="updateState('decrease')">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button onclick="updateState('increase')">
        <i class="fa-solid fa-chevron-right"/></i>
      </button>
    </div>
  </body>

  <script>
      let selectedIndex = 0;
      let imagesLength = 0;

      function initialize(index, length){
        selectedIndex = Number(index);
        imagesLength = Number(length);

        document.querySelectorAll(".image-item").forEach((img, index) => {
          if(index === selectedIndex) {
            img.classList.add("selected");
          }
        });
      }

      function updateState(newValue) {
        if(newValue === 'increase'){
          if(selectedIndex === imagesLength - 1){
            selectedIndex = 0;
          }else{
            ++selectedIndex;
          }
        }else if(newValue === 'decrease'){
          if(selectedIndex === 0){
            selectedIndex = imagesLength - 1;
          }else{
          --selectedIndex;
          }
        }else{
          selectedIndex = Number(newValue)
        }

        fetch(`/remote?index=${selectedIndex}`, {
          method: "PUT",
        })
        .then(res => {
          document.querySelectorAll(".image-item").forEach((img, index) => {
            if(index === selectedIndex) {
              img.classList.add("selected");
            }else{
              img.classList.remove("selected");
            }
          });
        })    
        .catch(err => console.error(err));
      }
    </script>
</html>
